# Bot de Telegram (BotFather). Nunca lo subas a git.
HERMES_BOT_TOKEN=tu_token_de_botfather_aqui
# OBLIGATORIO: chats que pueden darle órdenes al bot (tu chat id; varios separados por coma).
# Sin esto el bot no arranca. Cualquier otro chat se ignora y queda en ~/.jarvis/seguridad.jsonl.
HERMES_ALLOWED_CHAT_IDS=
# Chat que recibe los avisos de notify.py (tu chat con el bot).
HERMES_CHAT_ID=
# Carpeta donde viven los proyectos que /run puede usar.
HERMES_DOCUMENTS_PATH=~/Documents
# Agente que programa: opencode (paga por tokens a tu proveedor) o claude (usa tu plan de Claude).
HERMES_AGENT=opencode
# Modelo de OpenCode en formato proveedor/modelo (vacío = el de la configuración de OpenCode).
HERMES_OPENCODE_MODEL=
# Claves que el agente SÍ necesita (separadas por coma), por ejemplo la del proveedor de OpenCode. El resto se quita.
HERMES_AGENT_ENV_KEEP=
# Tiempo máximo del agente y de las pruebas, en minutos.
HERMES_AGENT_TIMEOUT_MIN=45
HERMES_TEST_TIMEOUT_MIN=20
# Dónde guarda Hermes su registro (trabajos, auditoría).
HERMES_DATA_DIR=~/.jarvis

# Vigía de PM2 (issue #7): avisa caídas, bucles de reinicio y PM2 sin responder. HERMES_VIGIA=0 lo apaga.
HERMES_VIGIA=1
HERMES_VIGIA_CADA_MIN=5
HERMES_VIGIA_MAX_REINICIOS=5
HERMES_VIGIA_VENTANA_MIN=10
# Horas de silencio (ej. 22-7): lo crítico llega igual; las recuperaciones se mandan juntas al terminar.
HERMES_SILENCIO=
# Latido externo (ej. un check de healthchecks.io). Si Hermes o el PC se caen, el aviso llega desde afuera.
HERMES_HEARTBEAT_URL=

# Cola de issues (issue #9): toma los issues con la etiqueta hermes:listo. Apagada por defecto (HERMES_COLA=1 la prende).
HERMES_COLA=0
HERMES_COLA_CADA_MIN=10
HERMES_COLA_MAX_FALLAS=2
HERMES_COLA_TOPE_DIA=5
# Intentos extra del agente cuando las pruebas fallan (se le pasa el error).
HERMES_COLA_REINTENTOS=1
# Revisor automático del diff antes de pedirte aprobación: claude u opencode (vacío = el mismo de HERMES_AGENT; 0 = apagado).
HERMES_REVISOR=
HERMES_REVISOR_TIMEOUT_MIN=15
# Con tu ✅ ("Funciona") Hermes hace el merge del PR a develop (nunca a main). 0 = el merge lo haces tú.
HERMES_MERGE=1
# Cada cuántos minutos te cuenta qué lleva el agente mientras trabaja (0 = no avisar).
HERMES_AVANCE_MIN=10
# Dónde se crean los worktrees (por defecto ~/.jarvis/worktrees). Nunca dentro de la carpeta de producción.
HERMES_WORKTREES_DIR=

# IA opcional para /chat. AI_PROVIDER=none la apaga.
AI_PROVIDER=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_MODEL=
