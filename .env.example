# Bot de Telegram (BotFather). Nunca lo subas a git.
HERMES_BOT_TOKEN=tu_token_de_botfather_aqui
# OBLIGATORIO: chats que pueden darle órdenes al bot (tu chat id; varios separados por coma).
# Sin esto el bot no arranca. Cualquier otro chat se ignora y queda en ~/.jarvis/seguridad.jsonl.
HERMES_ALLOWED_CHAT_IDS=
# Chat que recibe los avisos de notify.py (tu chat con el bot).
HERMES_CHAT_ID=
# Carpeta donde viven los proyectos que /run puede usar.
HERMES_DOCUMENTS_PATH=~/Documents
# Tiempo máximo de una ejecución de /run, en segundos.
HERMES_TIMEOUT_SECONDS=300

# IA opcional para /chat. AI_PROVIDER=none la apaga.
AI_PROVIDER=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_MODEL=
